{
  "name": "resume",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Mihir Chaturvedi's resume: one resume.tex builds the PDFs and resume.mihir.ch",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "pdf": "bash scripts/build-pdf.sh",
    "dev": "pnpm pdf && astro dev",
    "build": "pnpm pdf && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "format": "prettier --write .",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}

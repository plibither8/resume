---
import type { Inline as InlineNodes } from "../lib/tex/types";
import Inline from "./Inline.astro";

interface Props {
  bullets: InlineNodes[][];
}

const { bullets } = Astro.props;
---

<!-- Mirrors \resumeItem inside \resumeItemListStart: \small items with round bullets. -->{
  bullets.length > 0 && (
    <ul class="tex-small mt-1 list-disc space-y-0.5 pl-[2.2em]">
      {bullets.map((bullet) => (
        <li class="pl-0.5">
          <Inline nodes={bullet} />
        </li>
      ))}
    </ul>
  )
}

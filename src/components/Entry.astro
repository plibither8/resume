---
import type { Entry } from "../lib/tex/types";
import Bullets from "./Bullets.astro";
import Inline from "./Inline.astro";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
---

<!-- Mirrors \resumeSubheading: bold title | dates, then italic \small subtitle | meta. -->
<article class="break-inside-avoid">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4">
    <h3 class="font-bold"><Inline nodes={entry.title} /></h3>
    <span><Inline nodes={entry.dates} /></span>
  </div>
  <div
    class="tex-small flex flex-wrap items-baseline justify-between gap-x-4 italic"
  >
    <span><Inline nodes={entry.subtitle} /></span>
    <span><Inline nodes={entry.meta} /></span>
  </div>
  <Bullets bullets={entry.bullets} />
</article>

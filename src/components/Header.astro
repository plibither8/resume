---
import type { Resume } from "../lib/tex/types";
import Inline from "./Inline.astro";

interface Props {
  resume: Resume;
}

const { resume } = Astro.props;
const external = (href: string) => /^https?:/.test(href);
---

<!-- Mirrors \resumeHeader: the name, then the contacts joined by "|". -->
<header class="text-center">
  <h1
    class="tex-huge flex items-center justify-center gap-3 leading-tight font-bold"
  >
    <img
      src="/logos/mihir.svg"
      alt=""
      width="28"
      height="31"
      class="h-[0.85em] w-auto"
    />
    {resume.name}
  </h1>
  <p class="tex-small mt-1 flex flex-wrap justify-center gap-x-1.5 gap-y-0.5">
    {
      resume.contacts.map((contact, i) => (
        <>
          {i > 0 && <span aria-hidden="true">|</span>}
          {contact.href ? (
            <a
              href={contact.href}
              {...(external(contact.href)
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >
              <Inline nodes={contact.label} />
            </a>
          ) : (
            <span>
              <Inline nodes={contact.label} />
            </span>
          )}
        </>
      ))
    }
  </p>
</header>

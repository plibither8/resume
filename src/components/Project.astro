---
import type { Project } from "../lib/tex/types";
import Bullets from "./Bullets.astro";
import Inline from "./Inline.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<!-- Mirrors \resumeProject: \small, bold name | italic description. -->
<article class="break-inside-avoid">
  <h3 class="tex-small">
    <strong><Inline nodes={project.name} /></strong>{" "}
    <span aria-hidden="true">|</span>{" "}
    <em><Inline nodes={project.description} /></em>
  </h3>
  <Bullets bullets={project.bullets} />
</article>

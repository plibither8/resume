---
import type { Project } from "../lib/tex/types";
import Bullets from "./Bullets.astro";
import Inline from "./Inline.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="break-inside-avoid">
  <h3 class="text-slate-800">
    <span class="font-semibold"><Inline nodes={project.name} /></span>
    <span class="mx-1 text-slate-300" aria-hidden="true">|</span>
    <span class="text-sm text-slate-500 italic"
      ><Inline nodes={project.description} /></span
    >
  </h3>
  <Bullets bullets={project.bullets} />
</article>

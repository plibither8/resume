---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="space-y-3 break-inside-avoid-page">
  <h2
    class="flex items-center gap-3 text-xs font-bold tracking-widest text-slate-500 uppercase after:h-px after:flex-1 after:bg-slate-200"
  >
    {title}
  </h2>
  <slot />
</section>

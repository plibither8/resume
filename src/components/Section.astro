---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!-- Mirrors \section: \large bold title over a full-width rule. -->
<section class="mt-4">
  <h2 class="tex-large border-b border-black pb-0.5 font-bold">{title}</h2>
  <div class="mt-1.5 pl-[0.15in]">
    <slot />
  </div>
</section>

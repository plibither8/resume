---
import { execFileSync } from "node:child_process";
import tex from "../../resume/resume.tex?raw";
import Entry from "../components/Entry.astro";
import Header from "../components/Header.astro";
import Inline from "../components/Inline.astro";
import Project from "../components/Project.astro";
import Section from "../components/Section.astro";
import { parseResume, plainText } from "../lib/tex/parse";
import "../styles/global.css";

const resume = parseResume(tex);

/** Month of the last commit that touched resume.tex, or today if git history isn't available. */
function lastUpdated(): string {
  const format = (d: Date) =>
    d.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
  try {
    const iso = execFileSync(
      "git",
      ["log", "-1", "--format=%cI", "--", "resume/resume.tex"],
      { encoding: "utf8" }
    ).trim();
    if (iso) return format(new Date(iso));
  } catch {
    // Not a git checkout (or git missing): fall back to the build date.
  }
  return format(new Date());
}

// The page description: the summary if the tex has one, else the latest role.
const latest = resume.sections
  .flatMap((s) => s.blocks)
  .find((b) => b.kind === "entry");
const description = resume.summary
  ? plainText(resume.summary)
  : latest
    ? `${resume.name}: ${plainText(latest.title)} at ${plainText(latest.subtitle)}. Resume with full and 1-page PDFs.`
    : `${resume.name}'s resume.`;
const title = `${resume.name} · Resume`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/logos/mihir.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/lmroman10-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/lmroman10-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="px-3 py-5 sm:px-6 sm:py-8 print:p-0">
    <!-- Site chrome: not part of the resume, so it isn't in the tex. -->
    <nav
      class="mx-auto mb-3 flex max-w-[8.5in] flex-wrap items-center justify-between gap-2 px-1 font-sans text-xs text-slate-400 print:hidden"
      aria-label="Resume files"
    >
      <span>Last updated {lastUpdated()}</span>
      <span class="flex gap-3">
        <a class="hover:text-white" href="/resume.pdf">Download PDF</a>
        <a class="hover:text-white" href="/resume-1page.pdf">1-page PDF</a>
        <a
          class="hover:text-white"
          href="https://github.com/plibither8/resume"
          target="_blank"
          rel="noopener noreferrer">Source</a
        >
      </span>
    </nav>

    <!-- The paper: a web rendering of resume.tex in the PDF's typography. -->
    <main
      class="paper mx-auto max-w-[8.5in] bg-white px-5 py-7 shadow-2xl shadow-black/40 sm:px-[0.5in] sm:py-[0.5in] print:max-w-none print:p-0 print:shadow-none"
    >
      <Header resume={resume} />

      {
        resume.summary && (
          <Section title="Professional Summary">
            <p class="-ml-[0.15in]">
              <Inline nodes={resume.summary} />
            </p>
          </Section>
        )
      }

      {
        resume.sections.map((section) => (
          <Section title={section.title}>
            {section.blocks.every((b) => b.kind === "skill") ? (
              <dl class="tex-small">
                {section.blocks.map(
                  (b) =>
                    b.kind === "skill" && (
                      <div>
                        <dt class="inline font-bold">
                          <Inline nodes={b.label} />
                        </dt>
                        :{" "}
                        <dd class="inline">
                          <Inline nodes={b.items} />
                        </dd>
                      </div>
                    )
                )}
              </dl>
            ) : section.blocks.every((b) => b.kind === "achievement") ? (
              <ul class="tex-small space-y-1.5">
                {section.blocks.map(
                  (b) =>
                    b.kind === "achievement" && (
                      <li>
                        <strong>
                          <Inline nodes={b.title} />
                        </strong>{" "}
                        <span aria-hidden="true">|</span>{" "}
                        <em>
                          <Inline nodes={b.detail} />
                        </em>
                      </li>
                    )
                )}
              </ul>
            ) : (
              <div class="space-y-2">
                {section.blocks.map((b) =>
                  b.kind === "entry" ? (
                    <Entry entry={b} />
                  ) : b.kind === "project" ? (
                    <Project project={b} />
                  ) : null
                )}
              </div>
            )}
          </Section>
        ))
      }
    </main>
  </body>
</html>

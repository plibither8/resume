{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A Worker with no script: it only serves the static Astro build and the PDFs.
  "name": "resume",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "workers_dev": true,
  // Cloudflare manages the DNS record for a custom domain; don't add one by hand.
  "routes": [{ "pattern": "resume.mihir.ch", "custom_domain": true }],
}
